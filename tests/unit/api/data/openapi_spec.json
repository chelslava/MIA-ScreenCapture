          "type": "boolean"
         }
        }
       },
       "examples": {
        "enable": {
         "summary": "Включить задачу",
         "value": {
          "enabled": true
         }
        },
        "disable": {
         "summary": "Выключить задачу",
         "value": {
          "enabled": false
         }
        }
       }
      }
     }
    },
    "responses": {
