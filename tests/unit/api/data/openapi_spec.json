        "schema": {
         "type": "object",
         "properties": {
          "success": {
           "type": "boolean",
           "example": true
          },
          "data": {
           "type": "object",
           "properties": {
            "enabled": {
             "type": "boolean"
            }
           }
          }
         }
        }
       }
      }
     }
    }
   }
